{
  "name": "pic-privacy-rm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Strip EXIF, XMP, GPS and C2PA metadata from images, entirely in your browser.",
  "license": "MIT",
  "author": "illagerCPR",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "python3 tools/make_fixtures.py",
    "verify": "python3 tools/verify.py",
    "real": "python3 tools/fetch_real.py",
    "check": "pnpm typecheck && pnpm test && pnpm build && node tools/check_offline.mjs",
    "test:e2e": "playwright test",
    "check:e2e": "pnpm exec playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.25.0"
}
