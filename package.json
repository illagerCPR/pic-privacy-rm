{
  "name": "pic-privacy-rm",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Strip EXIF, XMP, GPS and C2PA metadata from images, entirely in your browser.",
  "license": "MIT",
  "author": "illagerCPR",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "python3 tools/make_fixtures.py",
    "verify": "python3 tools/verify.py",
    "real": "python3 tools/fetch_real.py",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && node tools/check_offline.mjs",
    "test:e2e": "playwright test",
    "check:e2e": "pnpm exec playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
